function A = laplacianMatrix(N, M, L, H)
% A = laplacianMatrix(N, M, L, H)
% Matrix of the discrete Laplacian
% with periodic boundary conditions.
%   N, M : number of interior cells in x and y
%   L, H : domain size in x and y [m]
%   A    : sparse matrix (N*M)x(N*M). Perturbed: A(1,1) modified so it
%          is not singular (pressure is defined up to a constant).

hx = L/N;
hy = H/M;

% 1) Index map: K(i,j) = position of cell (i,j) in the vector.
%    vector2field places the numbers 1..N*M in their cells (same ordering
%    as field2vector), and halo_update copies the indices of the opposite
%    side into the halo, so periodic neighbours come out automatically.

K = vector2field((1:N*M)', N, M); % Num del 1 fins a NxM en columna; per aixo trasposada
% Si fas plot de K et surt 1,2,3... pero halos amb 0 per tant li fas ara el
% halo_update pq se sàpiguen tots els veïns
K = halo_update(K);

% 2) Creo mat A buida amb sparse mode
A = sparse(N*M, N*M);

for j = 2:M+1                       % Paso por cada celda...
    for i = 2:N+1
        p    = K(i,j);             %    ¿Qué número es p?
        est  = K(i+1,j);           %    ¿Qué número tiene el de mi derecha?
        west = K(i-1,j);           %    ¿Y el de mi izquierda?
        north = K(i,j+1);           %    ¿Y el de arriba?
        south   = K(i,j-1);           %    ¿Y el de abajo?

        A(p, p)    = -4;          %  En MI fila: -4 en mi columna...
        A(p, est)  = 1;           %    ...y 1 en la columna de cada vecino
        A(p, west) = 1;
        A(p, north) = 1;
        A(, south)   = 1;
    end
end

A(1,1) = -5;                        % 6. Quitar la singularidad (p.56)
end