%% Aerodinamica, Mecanica de Vol i Orbital - Project: Part B
% Pressure-velocity coupling verification (Projection Method)
% Reference: Topic 2, Slides 61 & 63.

clear; clc;

%% 1. Mesh definition
N = 3;
M = 3;
L = 1.0;
H = 1.0;

nu=0.01;
t_final=0.5;
f_cfl=0.1;

mesh = create_mesh(N, M, L, H);

% Precomputation of Laplacian matrix:
A = laplacianMatrix(mesh);

% Initialization of velocities fields:
[u1_sym, u2_sym] = get_analytical_solution();
fu = matlabFunction(u1_sym, 'Vars', [sym('x'), sym('y')]);
fv = matlabFunction(u2_sym, 'Vars', [sym('x'), sym('y')]);

[u, v] = set_velocity_field(mesh.xu, mesh.yu, mesh.xv, mesh.yv, fu, fv);
u = halo_update(u);
v = halo_update(v);

t=0;
step=0;

Ru_prev =[];
Rv_prev =[];

% Bucle temporal

while t<t_final
    step=+1;
    [dt,dt_c,dt_d]=time_stability(mesh,u,v,nu,f_cfl);
    
    % Verificació de si t ha arribat a la solució final

    if t+dt>t_final
        dt = t_final -t;
    end

    % Pas 1: Calcular R i Rprev
    [Ru,Rv]=evaluate(u,v,nu,Mesh);

    if step==1
        up=u+dt*Ru;
        vp=v+dt*Rv;
    else
        up=delta_t*(3/2*R_u-1/2*Rprev_u);
        vp=delta_t*(3/2*R_v-1/2*Rprev_v);
    end
end


up=delta_t*(3/2*R_u-1/2*Rprev_u);
vp=delta_t*(3/2*R_v-1/2*Rprev_v);

%% 3. Step 1: Integrated divergence of u^p
d_p = diverg(u_p, v_p, mesh);
print_field(d_p, 'Divergence of u^p (before correction)');

% Check global mass balance (sum of Poisson source terms must be zero)
sum_div_p = sum(d_p(2:N+1, 2:M+1), 'all');
fprintf('Sum of divergence of u^p: %e\n\n', sum_div_p);

%% 4. Step 2: Laplacian matrix
A = laplacianMatrix(mesh);

%% 5. Step 3: Field to algebraic vector
b = field2vector(d_p, mesh);

%% 6. Step 4: Solve Poisson linear system: A * p = b
p = A \ b;

%% 7. Step 5: Vector to 2D field and halo update
P = vector2field(p, mesh);

%% 8. Step 6: Gradient of pseudo-pressure & velocity correction
[gx, gy] = gradient(mesh, P);

u_next = halo_update(u_p - gx);
v_next = halo_update(v_p - gy);

%% 9. Step 7: Divergence of corrected velocity u^{n+1}
d_next = diverg(u_next, v_next, mesh);
print_field(d_next, 'Divergence of u^{n+1} (after correction)');

%% 10. Numerical verification summary
max_div_before = max(abs(d_p(2:N+1, 2:M+1)), [], 'all');
max_div_after  = max(abs(d_next(2:N+1, 2:M+1)), [], 'all');

fprintf('Maximum divergence before correction: %e\n', max_div_before);
fprintf('Maximum divergence after correction : %e\n', max_div_after);


function [u1, u2] = get_analytical_solution()
syms x y;
u1 = cos(2*pi*x)*sin(2*pi*y);
u2 = -sin(2*pi*x)*cos(2*pi*y);
end