function cv = convective_v(u,v,hx,hy)
% cv = convective_v(u,v,hx,hy)
% Volume integral of the convective term of the y-momentum equation at
% every inner v node. Halo of cv is not updated.
% Author: Pablo Urioste // Marc Antich // Martí Esquerda
for i=2:1:N+1
    dx=mesh.
    for j=1:1:N+1
        dy_plus=mesh.yu(j)-mesh.yu(j-1);
        dy_minus=
       
        vn = (v(i,j+1)+v(i,j))/2;
        vs = (v(i,j-1)+v(i,j))/2;
        ve = (v(i+1,j)+v(i,j))/2;
        vw = (v(i-1,j)+v(i,j))/2;
        
        Fn = (v(i,j+1)*dx+v(i+1,j)*dx)/2;
        Fs = (v(i,j-1)*dx+v(i+1,j)*dx)/2;
        Fe = (u(i,j)*dy_minus+u(i,j+1)*dy_plus)/2;
        Fw = (u(i-1,j)*dy_minus+v(i-1,j+1)*dy_plus)/2;
        cu(i,j)=ve*Fe-vw*Fw+vn*Fn-vs*Fs;
    end
end

end

end
